# Runtime
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_API_TOKEN=replace-with-an-admin-token
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000

# Persistence and jobs
DATABASE_URL=postgresql+psycopg://doctranslator:doctranslator@postgres:5432/doctranslator
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/documents
FILE_RETENTION_DAYS=30
MAX_UPLOAD_MB=100
MAX_PAGE_COUNT=500

# First-run seeds only. These values are editable and persisted in Settings.
DEFAULT_TARGET_LANGUAGE=en
OCR_CONFIDENCE_THRESHOLD=0.80
PROVIDER_SECRET_ENCRYPTION_KEY=
